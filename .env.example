# Root .env — читается docker-compose.yml.
# Скопируй в .env. .env коммитить нельзя (см. .gitignore).

# Postgres credentials (создаются при первом старте postgres container)
POSTGRES_USER=meal
POSTGRES_PASSWORD=meal
POSTGRES_DB=meal_planner

# Anthropic Claude API
ANTHROPIC_API_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Apple Reminders / CalDAV
APPLE_ID=
APPLE_APP_PASSWORD=
APPLE_REMINDERS_LIST=Daily

# Logging
LOG_LEVEL=info
