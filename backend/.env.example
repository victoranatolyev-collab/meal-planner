# Backend environment (Next.js)
# Скопируй в .env и подставь реальные значения. .env коммитить нельзя — он в .gitignore.

# Database (заполняется в Phase 0 при добавлении Prisma)
DATABASE_URL=postgresql://meal:meal@localhost:5432/meal_planner

# Anthropic Claude API (Phase 2+)
ANTHROPIC_API_KEY=

# Telegram bot (Phase 6)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Apple Reminders / CalDAV (Phase 5)
APPLE_ID=
APPLE_APP_PASSWORD=
APPLE_REMINDERS_LIST=Daily

# Logging
LOG_LEVEL=info
NODE_ENV=development
