// Prisma schema для meal-planner backend.
// Каждая сущность из docs/ROADMAP.json соответствует модели.
// Сейчас — Phase 0: только User + Profile. Остальные сущности добавим в соответствующих фазах.
//
// Документация Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Учётная запись пользователя (multi-user-ready).
/// Phase 0 / ent-users. На старте — 1 запись seed'ом.
/// Auth-поля добавим в Auth.js фазе.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile         Profile?
  nutritionTarget NutritionTarget?
  tagRules        TagRule[]
  recipes         Recipe[]
  stockItems      StockItem[]
  weekPlans       WeekPlan[]

  @@map("users")
}

/// Профиль пользователя — 1:1 с User.
/// Phase 0 / ent-profile. Имя, локаль. Антропометрия и health-данные — в `health_records` (Phase 3).
model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  locale    String   @default("ru")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ============================================================
// Phase 1 — Catalog
// Источники = append-only снимки парсеров (история).
// Каталог ingredients = общий, не привязан к user (см. HISTORY 2026-05-24).
// ============================================================

/// Источник ингредиента — enum для нормализованного каталога.
/// CUSTOM — задел для пользовательских ингредиентов (домашние, дача), без привязки к магазину.
enum IngredientSource {
  FIVEKA
  TSEH
  LL
  VV
  CUSTOM
}

/// Сырые данные одного запуска парсера Пятёрочки (5К).
/// Phase 1 / ent-source-5ka. Append-only: каждый успешный парс — новая запись.
/// Самый свежий снимок: `ORDER BY parsed_at DESC LIMIT 1`.
model Source5ka {
  id        String   @id @default(uuid())
  parsedAt  DateTime @default(now()) @map("parsed_at")
  raw       Json     @db.JsonB
  summary   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parsedAt(sort: Desc)])
  @@map("source_5ka")
}

/// Сырые данные одного запуска парсера Цех 85.
/// Phase 1 / ent-source-tseh. Append-only.
model SourceTseh {
  id        String   @id @default(uuid())
  parsedAt  DateTime @default(now()) @map("parsed_at")
  raw       Json     @db.JsonB
  summary   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parsedAt(sort: Desc)])
  @@map("source_tseh")
}

/// Сырые данные одного запуска парсера «Люди Любят».
/// Phase 1 / ent-source-ll. Append-only.
model SourceLl {
  id        String   @id @default(uuid())
  parsedAt  DateTime @default(now()) @map("parsed_at")
  raw       Json     @db.JsonB
  summary   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parsedAt(sort: Desc)])
  @@map("source_ll")
}

/// Сырые данные одного запуска парсера ВкусВилл.
/// Phase 1 / ent-source-vv. Append-only.
model SourceVv {
  id        String   @id @default(uuid())
  parsedAt  DateTime @default(now()) @map("parsed_at")
  raw       Json     @db.JsonB
  summary   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parsedAt(sort: Desc)])
  @@map("source_vv")
}

/// Общий нормализованный каталог ингредиентов.
/// Phase 1 / ent-ingredients. Все парсеры пишут сюда. БЕЗ привязки к user — каталог общий.
/// Дубли разрешаются по (name, source, pack_size).
///
/// Phase 2: добавлены теги (tags text[]) — это ключевой механизм валидации правил.
/// GIN индекс на tags создаётся вручную в миграции (Prisma пока не умеет inline GIN).
model Ingredient {
  id           String           @id @default(uuid())
  name         String
  source       IngredientSource
  externalCode String?          @map("external_code")
  kcal100g     Decimal?         @map("kcal_100g") @db.Decimal(8, 2)
  protein100g  Decimal?         @map("protein_100g") @db.Decimal(6, 2)
  fat100g      Decimal?         @map("fat_100g") @db.Decimal(6, 2)
  carbs100g    Decimal?         @map("carbs_100g") @db.Decimal(6, 2)
  pricePer100g Decimal?         @map("price_per_100g") @db.Decimal(10, 2)
  weightG      Int?             @map("weight_g")
  packSize     String?          @map("pack_size")
  unit         String           @default("g")
  tags         String[]         @default([])
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  recipeIngredients RecipeIngredient[]
  stockItems        StockItem[]

  @@unique([name, source, packSize], name: "uniq_name_source_pack")
  @@index([source])
  @@index([name])
  @@map("ingredients")
}

// ============================================================
// Phase 2 — Recipes + Tag-based Rules
// Tag-based система: ingredients.tags[] + recipe_tags + tag_dictionary.
// Правила = выборки SQL по тегам (см. docs/HISTORY.md 2026-05-25).
// ============================================================

/// Категория тега — группировка для UI и валидации.
enum TagCategory {
  NUTRIENT // 'protein', 'iron', 'calcium'
  ALLERGEN // 'lactose', 'gluten', 'nuts'
  CATEGORY // 'meat', 'dairy', 'vegetable'
  BEHAVIOR // 'caffeine', 'alcohol', 'sweetener'
  MEAL_TAG // 'iron_meal', 'sweet_breakfast', 'training_meal' (только для recipes)
  OTHER
}

/// Справочник всех известных тегов. Не FK к ingredients.tags[] (loose coupling).
/// UI берёт отсюда автокомплит + валидацию имён.
model Tag {
  id          String      @id @default(uuid())
  name        String      @unique
  category    TagCategory
  description String?
  isSystem    Boolean     @default(false) @map("is_system")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([category])
  @@map("tag_dictionary")
}

/// Целевые КБЖУ + бюджет (1:1 с User).
/// Phase 2 / часть ent-nutrition-rules.
model NutritionTarget {
  id                      String   @id @default(uuid())
  userId                  String   @unique @map("user_id")
  kcalPerDay              Decimal  @map("kcal_per_day") @db.Decimal(7, 2)
  proteinGPerDay          Decimal  @map("protein_g_per_day") @db.Decimal(6, 2)
  fatGPerDay              Decimal  @map("fat_g_per_day") @db.Decimal(6, 2)
  carbsGPerDay            Decimal  @map("carbs_g_per_day") @db.Decimal(6, 2)
  proteinGPerKgMin        Decimal? @map("protein_g_per_kg_min") @db.Decimal(4, 2)
  budgetTargetRubPerWeek  Decimal? @map("budget_target_rub_per_week") @db.Decimal(8, 2)
  budgetSoftCapRubPerWeek Decimal? @map("budget_soft_cap_rub_per_week") @db.Decimal(8, 2)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nutrition_targets")
}

/// Виды правил на тегах.
enum RuleKind {
  BAN_TAG // запрет ингредиента с этим тегом (везде)
  BAN_TAG_IN_MEAL // запрет в рецептах с meal_tag
  REQUIRE_TAG_IN_MEAL // обязателен в рецептах с meal_tag
  MIN_PER_WEEK // минимум приёмов с этим тегом за неделю (quantity)
  MAX_PER_WEEK // максимум приёмов с этим тегом за неделю (quantity)
}

/// Правила питания пользователя — все через теги.
/// Phase 2 / часть ent-nutrition-rules.
model TagRule {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  ruleKind     RuleKind @map("rule_kind")
  tagName      String   @map("tag_name")
  mealTag      String?  @map("meal_tag")
  quantity     Int?
  exceptionTag String?  @map("exception_tag")
  reason       String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([tagName])
  @@map("tag_rules")
}

/// Источник появления рецепта.
enum RecipeSource {
  LLM // сгенерирован Claude API через scr-search-recipes
  MANUAL // создан пользователем вручную через UI/агента
  IMPORTED // импортирован из внешнего источника (например cookbook scraper в будущем)
}

/// Рецепт — per-user (LLM генерит под индивидуальный профиль).
/// Phase 2 / ent-recipes. Статус-флаги (is_relevant/is_normalized/is_approved) определяют,
/// в какой части пайплайна находится рецепт.
model Recipe {
  id               String       @id @default(uuid())
  userId           String       @map("user_id")
  name             String
  instructions     String       @default("")
  isRelevant       Boolean      @default(false) @map("is_relevant")
  isNormalized     Boolean      @default(false) @map("is_normalized")
  isApproved       Boolean      @default(false) @map("is_approved")
  rejectionReasons String[]     @default([]) @map("rejection_reasons")
  rawIngredients   Json?        @map("raw_ingredients") @db.JsonB
  totalKcal        Decimal?     @map("total_kcal") @db.Decimal(8, 2)
  totalProteinG    Decimal?     @map("total_protein_g") @db.Decimal(7, 2)
  totalFatG        Decimal?     @map("total_fat_g") @db.Decimal(7, 2)
  totalCarbsG      Decimal?     @map("total_carbs_g") @db.Decimal(7, 2)
  source           RecipeSource @default(MANUAL)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  tags        RecipeTag[]
  planItems   PlanMealItem[]

  @@index([userId])
  @@index([userId, isApproved])
  @@map("recipes")
}

/// Junction: ингредиент в рецепте с количеством.
/// fresh_addon = true для свежих добавок поверх (зелень, специи).
model RecipeIngredient {
  recipeId     String  @map("recipe_id")
  ingredientId String  @map("ingredient_id")
  qtyG         Int     @map("qty_g")
  freshAddon   Boolean @default(false) @map("fresh_addon")
  note         String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

/// Статус LLM-job в llm_jobs audit-таблице.
enum LlmJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Audit-лог LLM-вызовов из llm-service. См. ARCHITECTURE.md §10.12.
/// Запись создаётся при старте, обновляется при completion. Используется
/// для cost-tracking, отладки, мониторинга.
/// pg-boss tracks queue state (separate `pgboss.job` table) — это наш аудит.
model LlmJob {
  id               String       @id @default(uuid())
  pgBossJobId      String?      @unique @map("pg_boss_job_id")
  jobKind          String       @map("job_kind")
  userId           String?      @map("user_id")
  provider         String
  model            String
  status           LlmJobStatus @default(PENDING)
  input            Json?        @db.JsonB
  output           Json?        @db.JsonB
  error            String?
  inputTokens      Int?         @map("input_tokens")
  outputTokens     Int?         @map("output_tokens")
  cacheReadTokens  Int?         @map("cache_read_tokens")
  cacheWriteTokens Int?         @map("cache_write_tokens")
  costUsd          Decimal?     @map("cost_usd") @db.Decimal(10, 6)
  durationMs       Int?         @map("duration_ms")
  createdAt        DateTime     @default(now()) @map("created_at")
  completedAt      DateTime?    @map("completed_at")

  @@index([jobKind, status])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("llm_jobs")
}

/// Конвертация единиц измерения → грамм.
/// Phase 2 / scr-normalize-recipe. Универсальные дефолты + опциональный per-tag override.
/// Seed строится в миграции pg_trgm_and_units (system-rows, is_system=true).
model UnitConversion {
  id            String   @id @default(uuid())
  unit          String   @unique
  gramsPerUnit  Decimal  @map("grams_per_unit") @db.Decimal(10, 4)
  ingredientTag String?  @map("ingredient_tag")
  description   String?
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("unit_conversions")
}

/// Junction: теги рецепта (для scope правил BAN_TAG_IN_MEAL / REQUIRE_TAG_IN_MEAL).
/// Примеры: 'iron_meal', 'sweet_breakfast', 'training_meal'.
model RecipeTag {
  recipeId String @map("recipe_id")
  tagName  String @map("tag_name")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagName])
  @@index([tagName])
  @@map("recipe_tags")
}

// ============================================================
// Phase 3 — Plan (нормы, остатки, план недели)
// ============================================================

/// Остатки дома — что и сколько есть у пользователя сейчас.
/// Phase 3 / ent-stock. Одна строка на (user, ingredient) — текущее количество в граммах.
/// scr-calc-stock пересчитывает: последняя инвентаризация ± план ± заказы ± дневник.
/// Аналог секции stock_at_home из старого plans/week_*.json.
model StockItem {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  ingredientId String   @map("ingredient_id")
  qtyG         Int      @map("qty_g")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([userId, ingredientId], name: "uniq_user_ingredient")
  @@index([userId])
  @@map("stock")
}

/// Статус недельного плана.
enum WeekPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Недельный план питания. Phase 3 / ent-week-plan.
/// Структура (точно как legacy plans/week_*.json): week_plans → plan_days → plan_meals → plan_meal_items.
/// Цели КБЖУ + бюджет — СНИМОК на момент создания (план = исторический артефакт,
/// правка NutritionTarget позже не меняет старые планы).
model WeekPlan {
  id               String         @id @default(uuid())
  userId           String         @map("user_id")
  weekIso          String         @map("week_iso") // "2026-W21"
  startDate        DateTime       @map("start_date") @db.Date
  endDate          DateTime       @map("end_date") @db.Date
  status           WeekPlanStatus @default(DRAFT)
  kcalTarget       Decimal        @map("kcal_target") @db.Decimal(7, 2)
  proteinGTarget   Decimal        @map("protein_g_target") @db.Decimal(6, 2)
  fatGTarget       Decimal        @map("fat_g_target") @db.Decimal(6, 2)
  carbsGTarget     Decimal        @map("carbs_g_target") @db.Decimal(6, 2)
  budgetTargetRub  Decimal?       @map("budget_target_rub") @db.Decimal(8, 2)
  budgetSoftCapRub Decimal?       @map("budget_soft_cap_rub") @db.Decimal(8, 2)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  days PlanDay[]

  @@unique([userId, weekIso], name: "uniq_user_week")
  @@index([userId, status])
  @@map("week_plans")
}

/// День плана. day_type — свободная строка (training / office / rest), как legacy.
model PlanDay {
  id         String   @id @default(uuid())
  weekPlanId String   @map("week_plan_id")
  date       DateTime @db.Date
  dayType    String?  @map("day_type")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  weekPlan WeekPlan   @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  meals    PlanMeal[]

  @@unique([weekPlanId, date], name: "uniq_plan_date")
  @@index([weekPlanId])
  @@map("plan_days")
}

/// Приём пищи в дне. mealTags — meal-уровневые теги (sweet_breakfast, c1_exclusion, iron_meal)
/// для валидатора недели (MIN/MAX_PER_WEEK, exception_tag — см. ARCHITECTURE §7.2/§7.3).
model PlanMeal {
  id        String   @id @default(uuid())
  planDayId String   @map("plan_day_id")
  name      String
  time      String? // "08:30" (HH:MM)
  sortOrder Int      @map("sort_order")
  mealTags  String[] @default([]) @map("meal_tags")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  planDay PlanDay        @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  items   PlanMealItem[]

  @@index([planDayId])
  @@map("plan_meals")
}

/// Позиция приёма — одна ссылка на рецепт + порция.
/// portionFactor: предрасчитанный объём порции (0.8 / 1.0 / 2.0), default 1.0 — масштабирует
/// КБЖУ рецепта. fromStock — берётся из остатков; tail — сладкий «хвост» / добавка.
model PlanMealItem {
  id            String   @id @default(uuid())
  planMealId    String   @map("plan_meal_id")
  recipeId      String   @map("recipe_id")
  portionFactor Decimal  @default(1.0) @map("portion_factor") @db.Decimal(4, 2)
  fromStock     Boolean  @default(false) @map("from_stock")
  tail          Boolean  @default(false)
  sortOrder     Int      @map("sort_order")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  planMeal PlanMeal @relation(fields: [planMealId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@index([planMealId])
  @@index([recipeId])
  @@map("plan_meal_items")
}
