# Frontend environment (Vite).
# Все переменные, доступные в браузере, должны начинаться с VITE_.
# Скопируй в .env. .env коммитить нельзя — он в .gitignore.

# Backend API base URL.
# В dev — пусто (используется proxy /api → http://localhost:3000, см. vite.config.ts).
# В prod — например, https://example.com (nginx сам проксирует /api).
VITE_API_BASE_URL=
