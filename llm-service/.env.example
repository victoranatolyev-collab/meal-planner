# LLM-service environment.
# Скопируй в .env. .env коммитить нельзя (gitignored).

# Postgres — shared с backend/worker. Pg-boss создаст свою schema `pgboss`.
DATABASE_URL=postgresql://meal:meal@localhost:5432/meal_planner

# Режим: stub (фикстуры) | cli (claude CLI subprocess) | api (Anthropic SDK).
# В dev и тестах рекомендуется stub.
LLM_MODE=stub

# Провайдер (когда LLM_MODE=api).
LLM_PROVIDER=anthropic

# Anthropic API key (только для LLM_MODE=api + LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=

# OpenAI (для LLM_PROVIDER=openai).
OPENAI_API_KEY=

# HTTP port (внутри контейнера).
PORT=3001

# Логгер.
LOG_LEVEL=info
NODE_ENV=development
