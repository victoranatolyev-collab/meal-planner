  "dishes": {
    "rice_paper_roll_sriracha": {
      "id": "rice_paper_roll_sriracha",
      "name": "Рулеты Sriracha Lemon Chicken (3 шт)",
      "ingredients": [
        {
          "ref": "local:chicken_severnaya_bone_in",
          "qty_g": 100,
          "note": "обжарить мелкими кубиками"
        },
        {
          "ref": "local:rice_paper",
          "qty_g": 30,
          "qty_units": 3,
          "note": "3 листа"
        },
        {
          "ref": "local:lettuce_iceberg_local",
          "qty_g": 30,
          "note": "лист подложка"
        },
        {
          "ref": "plu:3333628",
          "qty_g": 40,
          "note": "огурец julienne"
        },
        {
          "ref": "plu:43347",
          "qty_g": 40,
          "note": "перец красный julienne"
        },
        {
          "ref": "local:cilantro_fresh",
          "qty_g": 5
        },
        {
          "ref": "plu:4028162",
          "qty_g": 5,
          "note": "Sriracha в соус"
        },
        {
          "ref": "plu:3294954",
          "qty_g": 5,
          "note": "сок лимона в соус"
        }
      ],
      "prep": "batch_freeze_air_fryer",
      "method": "Курицу посолить/поперчить, обжарить мелкими кубиками 6-8 мин. Овощи julienne. Рис.бумагу окунуть 5-7 сек в тёплой воде до мягкости. На бумагу: лист салата подложкой → курица + овощи + кинза → завернуть как буррито плотно. Соус 1:1 Sriracha:сок лимона по вкусу (без мёда — нет в stock). Морозить сырые рулеты single-layer на противне 1ч, потом в zip-пакет (до 1 мес). Утром: 2-3 шт сразу из морозилки в аэрогриль 12-15 мин при 200°C.",
      "tags": [
        "batch_freeze",
        "high_protein",
        "low_fat",
        "frozen_thaw"
      ]
    },
