# Worker environment.
# Скопируй в .env. .env коммитить нельзя — он в .gitignore.

# Database — общий с backend (см. docs/ARCHITECTURE.md §6).
DATABASE_URL=postgresql://meal:meal@localhost:5432/meal_planner

# Anthropic Claude API — для генерации плана/коррекций из cron (Phase 3+).
ANTHROPIC_API_KEY=

# Apple Reminders / CalDAV (Phase 5).
APPLE_ID=
APPLE_APP_PASSWORD=
APPLE_REMINDERS_LIST=Daily

# Logging.
LOG_LEVEL=info
NODE_ENV=development
